# Copy to .env, then run: sh scripts/gen-keys.sh
CORS_ORIGINS=http://localhost:5173
MINIO_PUBLIC_URL=http://localhost:9000
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Host port the api-gateway is published on. If you change it, set PUBLIC_API_URL to the
# browser-reachable equivalent (it is baked into the frontend image at build time) and rebuild
# the frontend:  docker compose up -d --build frontend
GATEWAY_PORT=8080
PUBLIC_API_URL=http://localhost:8080
